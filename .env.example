# Copy to .env and fill in. Never commit .env.

# --- Supabase (Settings -> API Keys) -----------------------------------------
# Public, shipped to the browser (publishable key is public by design).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. The secret key bypasses RLS: never prefix it with VITE_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Pluggy (dashboard.pluggy.ai -> Applications) — server only -------------
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Items connected via Meu Pluggy, comma-separated, optional label before ':'.
PLUGGY_ITEM_IDS=XP:<item-uuid>,Wise:<item-uuid>
# Your Supabase auth user id (Authentication -> Users). Only this user can sync the items.
PLUGGY_OWNER_USER_ID=
